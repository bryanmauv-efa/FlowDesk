<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TermServMultiScreen.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TermServMultiScreen.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:TermServMultiScreen.ViewModels">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="24,20,24,4">
            <StackPanel Spacing="16">

                <!--  ===================== Connexion =====================  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardTitleStyle}"
                                Text="Connexion" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Nouvelle connexion"
                                    Command="{x:Bind ViewModel.NewProfileCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        <TextBlock Text="Nouvelle" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="Enregistrer la connexion" Command="{x:Bind ViewModel.SaveProfileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                        <TextBlock Text="Enregistrer" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="Supprimer la connexion" Command="{x:Bind ViewModel.DeleteProfileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock Text="Supprimer" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="Importer un fichier .rdp" Command="{x:Bind ViewModel.ImportRdpCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                        <TextBlock Text="Importer .rdp" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Connexion" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.ProfileNames}"
                                    SelectedItem="{x:Bind ViewModel.SelectedProfileName, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Serveur" />
                                <Grid>
                                    <TextBox
                                        Padding="11,5,38,6"
                                        PlaceholderText="nom ou adresse du serveur"
                                        Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        x:Name="ServerHistoryButton"
                                        Width="30"
                                        Height="26"
                                        AutomationProperties.Name="Serveurs déjà utilisés"
                                        Margin="0,0,3,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ServerHistory_Click"
                                        ToolTipService.ToolTip="Serveurs déjà utilisés">
                                        <FontIcon FontSize="10" Glyph="&#xE70D;" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Utilisateur" />
                                <TextBox PlaceholderText="domaine\utilisateur" Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" />
                                <StackPanel
                                    Margin="0,6,0,0"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE72E;" />
                                    <TextBlock Style="{StaticResource TechnicalTextStyle}" Text="Le mot de passe est demandé par Windows." />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ===================== Écrans =====================  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardTitleStyle}"
                                Text="{x:Bind ViewModel.ScreensHeader, Mode=OneWay}" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Identifier les écrans"
                                    Command="{x:Bind ViewModel.IdentifyCommand}"
                                    IsEnabled="{x:Bind ViewModel.IdentifyEnabled, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE890;" />
                                        <TextBlock Text="Identifier les écrans" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="Actualiser la liste des écrans"
                                    Command="{x:Bind ViewModel.RefreshMonitorsCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                        <TextBlock Text="Actualiser" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <toolkit:Segmented
                            HorizontalAlignment="Left"
                            ItemsSource="{x:Bind ViewModel.Presets}"
                            SelectedIndex="{x:Bind ViewModel.SelectedPresetIndex, Mode=TwoWay}" />

                        <ItemsControl
                            HorizontalAlignment="Center"
                            ItemTemplate="{StaticResource MonitorCardTemplate}"
                            ItemsSource="{x:Bind ViewModel.Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:MonitorMapPanel Inset="4" MaxMapHeight="300" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource TechnicalTextStyle}" Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />

                        <!--  Le déplacement d'une session déjà ouverte se fait depuis la page Sessions.  -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE7C4;" />
                            <TextBlock Style="{StaticResource TechnicalTextStyle}" Text="Une session déjà ouverte se déplace d'un écran à l'autre sans se reconnecter : page Sessions, ou Ctrl + Alt + Maj + ← / → depuis la session." />
                        </StackPanel>

                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.WarningText, Mode=OneWay}"
                            Severity="Warning"
                            Visibility="{x:Bind ViewModel.WarningVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!--  ===================== Options / Fiabilité =====================  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Options de session" />
                            <Grid ColumnSpacing="16" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <CheckBox Content="Presse-papiers partagé" IsChecked="{x:Bind ViewModel.Clipboard, Mode=TwoWay}" />
                                    <CheckBox Content="Imprimantes locales" IsChecked="{x:Bind ViewModel.Printers, Mode=TwoWay}" />
                                    <CheckBox Content="Son de la session" IsChecked="{x:Bind ViewModel.Sound, Mode=TwoWay}" />
                                    <CheckBox Content="Disques locaux" IsChecked="{x:Bind ViewModel.LocalDrives, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <CheckBox Content="Barre de connexion" IsChecked="{x:Bind ViewModel.ConnectionBar, Mode=TwoWay}" />
                                    <CheckBox Content="Reconnexion automatique" IsChecked="{x:Bind ViewModel.AutoReconnect, Mode=TwoWay}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="Raccourcis clavier Windows :" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.KeyboardOptions}"
                                        SelectedIndex="{x:Bind ViewModel.KeyboardHookIndex, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox
                                Content="Si un seul écran : fenêtre maximisée au lieu du plein écran (compatibilité)"
                                IsChecked="{x:Bind ViewModel.WindowedWhenSingle, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Fiabilité et vérification" />
                            <CheckBox
                                Content="Tous les écrans cochés : utiliser le mode multi-écrans standard (sans liste)"
                                IsChecked="{x:Bind ViewModel.MultimonSwitchWhenAll, Mode=TwoWay}" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button
                                    Command="{x:Bind ViewModel.OpenMappingCommand}"
                                    Content="Correspondance mstsc…"
                                    Style="{StaticResource CardActionButtonStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.MstscListCommand}"
                                    Content="Liste mstsc (/l)"
                                    Style="{StaticResource CardActionButtonStyle}" />
                                <Button
                                    Grid.Row="1"
                                    Command="{x:Bind ViewModel.PreviewCommand}"
                                    Content="Aperçu du fichier .rdp"
                                    Style="{StaticResource CardActionButtonStyle}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.DiagnosticCommand}"
                                    Content="Diagnostic des écrans"
                                    Style="{StaticResource CardActionButtonStyle}" />
                                <Button
                                    Grid.Row="2"
                                    Command="{x:Bind ViewModel.OpenSessionsFolderCommand}"
                                    Content="Dossier des sessions"
                                    Style="{StaticResource CardActionButtonStyle}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.CopyToDesktopCommand}"
                                    Content="Copier le .rdp sur le Bureau"
                                    Style="{StaticResource CardActionButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  ===================== Bandeau de lancement =====================  -->
        <Border
            Grid.Row="1"
            Margin="24,8,24,20"
            Padding="20,14"
            Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border
                        Width="22"
                        Height="22"
                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                        CornerRadius="11"
                        Visibility="{x:Bind ViewModel.OkVisibility, Mode=OneWay}">
                        <FontIcon
                            FontSize="11"
                            Foreground="White"
                            Glyph="&#xE73E;" />
                    </Border>
                    <Border
                        Width="22"
                        Height="22"
                        Background="{ThemeResource SystemFillColorCautionBrush}"
                        CornerRadius="11"
                        Visibility="{x:Bind ViewModel.WarnVisibility, Mode=OneWay}">
                        <FontIcon
                            FontSize="11"
                            Foreground="White"
                            Glyph="&#xE7BA;" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource TechnicalTextStyle}"
                    Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <Button
                    Grid.Column="2"
                    Height="46"
                    Padding="26,0"
                    AutomationProperties.Name="Se connecter"
                    Command="{x:Bind ViewModel.ConnectCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="Se connecter" />
                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
