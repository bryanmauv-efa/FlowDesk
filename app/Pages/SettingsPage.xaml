<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TermServMultiScreen.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:TermServMultiScreen.ViewModels">

    <ScrollViewer Padding="24,20,24,24">
        <StackPanel MaxWidth="1000" Spacing="6">
            <TextBlock
                Margin="0,0,0,10"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Paramètres" />

            <toolkit:SettingsCard Description="Le design est prévu pour le thème clair ; le thème sombre est pris en charge." Header="Apparence">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="180"
                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource CardTitleStyle}"
                Text="Numérotation des écrans" />

            <toolkit:SettingsExpander
                Description="Windows énumère ses écrans dans un ordre qui n'a rien à voir avec leur position. L'application fait la traduction toute seule ; ne forcez ces valeurs que si la session s'ouvre sur le mauvais écran."
                Header="Correspondance écran → identifiant mstsc"
                ItemsSource="{x:Bind ViewModel.Rows}">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.ManualMappingEnabled, Mode=TwoWay}"
                    OffContent="Automatique"
                    OnContent="Manuelle" />
                <toolkit:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="vm:MappingRowViewModel">
                        <toolkit:SettingsCard Description="{x:Bind Description}" Header="{x:Bind Header}">
                            <NumberBox
                                MinWidth="130"
                                Maximum="31"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind RdpIdValue, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </toolkit:SettingsExpander.ItemTemplate>
            </toolkit:SettingsExpander>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.MappingStatus, Mode=OneWay}"
                Severity="Informational" />

            <toolkit:SettingsCard Description="Remet la correspondance automatique et efface les valeurs forcées." Header="Réinitialiser la correspondance">
                <Button Command="{x:Bind ViewModel.ResetMappingCommand}" Content="Réinitialiser" />
            </toolkit:SettingsCard>

            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource CardTitleStyle}"
                Text="Vérifier" />

            <toolkit:SettingsCard Description="Affiche un grand numéro sur chaque écran physique pendant quelques secondes." Header="Identifier les écrans">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE890;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button Command="{x:Bind ViewModel.IdentifyCommand}" Content="Identifier" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Ouvre la liste officielle des écrans telle que mstsc.exe la voit." Header="Liste mstsc (/l)">
                <Button Command="{x:Bind ViewModel.MstscListCommand}" Content="Ouvrir" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Tout ce que l'application voit : positions, résolutions, les trois numérotations." Header="Diagnostic complet">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshMonitorsCommand}" Content="Réénumérer" />
                    <Button Command="{x:Bind ViewModel.DiagnosticCommand}" Content="Afficher" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Chaque lancement y est tracé : utile si une session s'ouvre au mauvais endroit." Header="Journal">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ShowLogCommand}" Content="Afficher" />
                    <Button Command="{x:Bind ViewModel.OpenDataFolderCommand}" Content="Ouvrir le dossier" />
                </StackPanel>
            </toolkit:SettingsCard>

            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource CardTitleStyle}"
                Text="Fichiers" />

            <toolkit:SettingsExpander Description="{x:Bind ViewModel.VersionText}" Header="Emplacements utilisés">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Connexions enregistrées">
                        <TextBlock
                            Style="{StaticResource TechnicalTextStyle}"
                            Text="{x:Bind ViewModel.ConfigPath}"
                            TextWrapping="NoWrap" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Fichiers .rdp générés">
                        <TextBlock
                            Style="{StaticResource TechnicalTextStyle}"
                            Text="{x:Bind ViewModel.SessionsPath}"
                            TextWrapping="NoWrap" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Journal">
                        <TextBlock
                            Style="{StaticResource TechnicalTextStyle}"
                            Text="{x:Bind ViewModel.LogPath}"
                            TextWrapping="NoWrap" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
