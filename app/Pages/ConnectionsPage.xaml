<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TermServMultiScreen.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TermServMultiScreen.ViewModels">

    <Grid Padding="24,20,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Connexions enregistrées" />

        <Grid Grid.Row="1">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TechnicalTextStyle}"
                Text="Double-cliquez sur une connexion pour la charger dans l'accueil." />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="Charger la connexion dans l'accueil"
                    Command="{x:Bind ViewModel.OpenCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                        <TextBlock Text="Charger" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.DuplicateCommand}" Content="Dupliquer" />
                <Button Command="{x:Bind ViewModel.ExportCommand}" Content="Copier sur le Bureau" />
                <Button Command="{x:Bind ViewModel.DeleteCommand}" Content="Supprimer" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource TechnicalTextStyle}"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                    TextAlignment="Center" />

                <ListView
                    DoubleTapped="List_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionItem">
                            <Grid Padding="4,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE71B;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock
                                        FontSize="13"
                                        Opacity="0.9"
                                        Text="{x:Bind Address}" />
                                    <TextBlock
                                        FontSize="12.5"
                                        Opacity="0.75"
                                        Text="{x:Bind UserName}" />
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind ScreensText}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.6"
                                        Text="{x:Bind OptionsText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
