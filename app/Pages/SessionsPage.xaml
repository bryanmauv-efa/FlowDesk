<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TermServMultiScreen.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TermServMultiScreen.ViewModels">

    <Grid Padding="24,20,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sessions" />

        <!--
            ===================== Sessions ouvertes =====================
            Déplacer la fenêtre d'une session en cours d'utilisation. Rien n'est réécrit : ni la
            connexion enregistrée, ni son fichier .rdp, ni selectedmonitors.
        -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Sessions ouvertes — changer d'écran sans se reconnecter" />
                        <TextBlock Style="{StaticResource TechnicalTextStyle}" Text="Déplace la fenêtre du Bureau à distance pendant son utilisation. La connexion enregistrée et son fichier .rdp ne sont pas modifiés." />
                    </StackPanel>
                    <Button
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Actualiser les sessions ouvertes"
                        Command="{x:Bind Live.RefreshWindowsCommand}"
                        ToolTipService.ToolTip="Relire la liste des fenêtres Bureau à distance ouvertes">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Actualiser" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--
                    Le réglage principal : avec lui, faire glisser la fenêtre suffit. Tout ce qui
                    suit n'est qu'un secours, pour une session qu'on ne peut pas attraper du tout.
                -->
                <ToggleSwitch
                    Header="Plein écran automatique sur l'écran d'arrivée"
                    IsOn="{x:Bind Live.FollowScreen, Mode=TwoWay}"
                    OffContent="Désactivé — utilisez les boutons ci-dessous"
                    OnContent="Faites glisser la fenêtre sur un autre écran : elle s'y met en plein écran toute seule" />

                <TextBlock
                    Style="{StaticResource TechnicalTextStyle}"
                    Text="Aucune session Bureau à distance ouverte en ce moment. Lancez une session : sa fenêtre apparaîtra ici et pourra être déplacée d'un écran à l'autre."
                    Visibility="{x:Bind Live.EmptyVisibility, Mode=OneWay}" />

                <StackPanel Spacing="12" Visibility="{x:Bind Live.WindowsVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Session à déplacer"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind Live.Windows}"
                            SelectedItem="{x:Bind Live.Selected, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind Live.ActivateWindowCommand}"
                            Content="Afficher"
                            ToolTipService.ToolTip="Mettre cette session au premier plan" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Déplacer vers :" />
                        <ItemsControl ItemsSource="{x:Bind Live.Targets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScreenTargetViewModel">
                                    <Button
                                        MinWidth="104"
                                        Command="{x:Bind MoveCommand}"
                                        Content="{x:Bind Label}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind ToolTipText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            Margin="10,0,0,0"
                            AutomationProperties.Name="Écran précédent"
                            Command="{x:Bind Live.MovePreviousCommand}"
                            ToolTipService.ToolTip="Écran précédent (Ctrl + Alt + Maj + flèche gauche)">
                            <FontIcon FontSize="14" Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Écran suivant"
                            Command="{x:Bind Live.MoveNextCommand}"
                            ToolTipService.ToolTip="Écran suivant (Ctrl + Alt + Maj + flèche droite)">
                            <FontIcon FontSize="14" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE765;" />
                        <TextBlock Style="{StaticResource TechnicalTextStyle}" Text="{x:Bind Live.HotkeyText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!--  Hors du bloc précédent : l'état doit aussi s'afficher quand aucune session n'est ouverte.  -->
                <TextBlock
                    FontSize="12.5"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind Live.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Sessions générées" />
                <TextBlock
                    Style="{StaticResource TechnicalTextStyle}"
                    Text="Chaque lancement produit un fichier .rdp réutilisable tel quel, écrans compris." />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="Relancer cette session"
                    Command="{x:Bind ViewModel.RelaunchCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Relancer" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShowContentCommand}" Content="Voir le contenu" />
                <Button Command="{x:Bind ViewModel.OpenFolderCommand}" Content="Ouvrir le dossier" />
                <Button Command="{x:Bind ViewModel.DeleteCommand}" Content="Supprimer" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource TechnicalTextStyle}"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                    TextAlignment="Center" />

                <ListView
                    DoubleTapped="List_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItem">
                            <Grid Padding="4,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7F4;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind ScreensText}" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{x:Bind WhenText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Derniers lancements (journal)" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11.5"
                                    Opacity="0.8"
                                    Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
