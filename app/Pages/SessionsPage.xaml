<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TermServMultiScreen.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TermServMultiScreen.ViewModels">

    <Grid Padding="24,20,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sessions générées" />

        <Grid Grid.Row="1">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TechnicalTextStyle}"
                Text="Chaque lancement produit un fichier .rdp réutilisable tel quel, écrans compris." />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="Relancer cette session"
                    Command="{x:Bind ViewModel.RelaunchCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Relancer" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShowContentCommand}" Content="Voir le contenu" />
                <Button Command="{x:Bind ViewModel.OpenFolderCommand}" Content="Ouvrir le dossier" />
                <Button Command="{x:Bind ViewModel.DeleteCommand}" Content="Supprimer" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource TechnicalTextStyle}"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                    TextAlignment="Center" />

                <ListView
                    DoubleTapped="List_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItem">
                            <Grid Padding="4,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7F4;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind ScreensText}" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{x:Bind WhenText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Derniers lancements (journal)" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11.5"
                                    Opacity="0.8"
                                    Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
