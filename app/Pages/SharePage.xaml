<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TermServMultiScreen.Pages.SharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,20,24,24">
        <StackPanel MaxWidth="1000" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Partage de sessions" />

            <!--  ===================== choix du sens =====================  -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ChooserVisibility, Mode=OneWay}">
                <TextBlock Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap">
                    Transmettez une connexion à quelqu'un qui utilise la même application, ou récupérez la
                    sienne. Le code contient toutes les données de la session : les deux applications ne
                    communiquent jamais entre elles et rien ne passe par le réseau. Aucun mot de passe n'est
                    inclus — l'application n'en conserve aucun.
                </TextBlock>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon
                                    FontSize="22"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE72D;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Partager une session" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap">
                                Choisissez une connexion enregistrée, décidez si l'utilisateur est inclus, et
                                obtenez un code à transmettre par message ou par courriel.
                            </TextBlock>
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.ChooseShareCommand}"
                                Content="Partager…"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon
                                    FontSize="22"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE896;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Recevoir un partage" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap">
                                Collez le code reçu : la connexion est recréée à l'identique sur ce poste, avec
                                ses écrans et ses options.
                            </TextBlock>
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.ChooseReceiveCommand}"
                                Content="Recevoir…" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!--  ===================== partager =====================  -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShareVisibility, Mode=OneWay}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardTitleStyle}"
                                Text="Partager une session" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.BackCommand}"
                                Content="Retour" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Session à partager" />
                            <ComboBox
                                MinWidth="320"
                                ItemsSource="{x:Bind ViewModel.ProfileNames}"
                                SelectedItem="{x:Bind ViewModel.SelectedProfileName, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource TechnicalTextStyle}" Text="{x:Bind ViewModel.ShareScreensSummary, Mode=OneWay}" />
                        </StackPanel>

                        <CheckBox
                            Content="Inclure le nom d'utilisateur de connexion"
                            IsChecked="{x:Bind ViewModel.IncludeUserName, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap">
                            Sans cette option, le destinataire renseignera son propre identifiant. Le mot de
                            passe n'est jamais partagé, dans aucun cas.
                        </TextBlock>

                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.GenerateCommand}"
                            Content="Générer le code"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.CodeVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Code à transmettre" />
                        <TextBox
                            FontFamily="Consolas"
                            FontSize="13"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.GeneratedCode, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource TechnicalTextStyle}"
                                Text="{x:Bind ViewModel.CodeInfo, Mode=OneWay}" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CopyCodeCommand}"
                                Content="Copier le code" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  ===================== recevoir =====================  -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ReceiveVisibility, Mode=OneWay}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardTitleStyle}"
                                Text="Recevoir un partage" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.BackCommand}"
                                Content="Retour" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Code reçu" />
                            <TextBox
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                FontSize="13"
                                Height="90"
                                PlaceholderText="FD1…"
                                Text="{x:Bind ViewModel.EnteredCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.AnalyseCommand}" Content="Analyser le code" />
                            <Button
                                Command="{x:Bind ViewModel.ImportCommand}"
                                Content="Importer la session"
                                IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource TechnicalTextStyle}" Text="{x:Bind ViewModel.ReceiveStatus, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ReceivedVisibility, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Contenu du code" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="12.5"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.ReceivedSummary, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
