<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TermServMultiScreen.Overlays.IdentifyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="#FF26262A" PointerPressed="Root_PointerPressed">
        <Viewbox
            MaxWidth="1500"
            MaxHeight="950"
            Margin="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="Uniform">
            <StackPanel Width="900" Spacing="4">
                <TextBlock
                    x:Name="BigNumber"
                    FontSize="260"
                    FontWeight="SemiBold"
                    Foreground="White"
                    LineHeight="270"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="PositionLabel"
                    FontSize="54"
                    FontWeight="SemiBold"
                    Foreground="White"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="Line1"
                    FontSize="28"
                    Foreground="White"
                    Opacity="0.85"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="Line2"
                    FontSize="28"
                    Foreground="White"
                    Opacity="0.85"
                    TextAlignment="Center" />
                <Border
                    x:Name="UsedBadge"
                    Margin="0,18,0,0"
                    Padding="26,10"
                    HorizontalAlignment="Center"
                    Background="#33FFFFFF"
                    CornerRadius="24">
                    <TextBlock
                        x:Name="UsedText"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>
                <TextBlock
                    Margin="0,24,0,0"
                    FontSize="22"
                    Foreground="White"
                    Opacity="0.6"
                    Text="Cliquez pour fermer"
                    TextAlignment="Center" />
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
